# Tures Engine — environment. Copy to .env. Every value is OPTIONAL for dev:
# with no keys, the engine falls back to the deterministic mock supplier.

# Server
PORT=8787
# Comma-separated origins allowed to call the engine (the demo on GitHub Pages, localhost, etc.)
CORS_ORIGINS=http://localhost:8787,https://toddfishman.github.io

# Supplier — Duffel. Present token => real Duffel test API. Absent => mock supplier.
# Get a test token at https://app.duffel.com (it starts with "duffel_test_").
DUFFEL_API_TOKEN=
DUFFEL_API_URL=https://api.duffel.com

# Agent loop (Chunk 2). Present => Claude tool-use planner; absent => deterministic planner.
# ANTHROPIC_API_KEY=

# Payments (Chunk 3/4). Present => Stripe charges a vault-stored PaymentMethod; absent => mock.
# STRIPE_SECRET_KEY=

# Vault (Chunk 4): 32-byte key (hex or base64) to encrypt connected-service credentials at rest.
# Absent => ephemeral per-process key (dev only; secrets won't survive a restart).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# VAULT_KEY=

# Real-money safety switch (Chunk 3). Must be "true" to permit bookings via a live supplier.
# ALLOW_LIVE_BOOKING=false

# Hardening (Chunk 6). When set, all routes except /health require Authorization: Bearer <key>
# (SSE uses ?token=<key>). Leave unset to run open (dev).
# ENGINE_API_KEY=
# Per-IP requests per minute (default 600).
# RATE_LIMIT_MAX=600

# Accounts & durability ---------------------------------------------------------
# Durable storage dir (accounts/vault/bookings persist here). Unset → in-memory only.
# DATA_DIR=./data
# Secret for signing session tokens. Unset → sessions drop on restart. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# Stripe subscription billing ---------------------------------------------------
# STRIPE_PRICE_SUBSCRIPTION=price_xxx   # the $99/mo recurring price id
# STRIPE_WEBHOOK_SECRET=whsec_xxx       # from `stripe listen` / the dashboard webhook
# PUBLIC_BASE_URL=https://toddfishman.github.io/tures-demo/v5  # for Checkout success/cancel redirects

# PII vault — VGS (Very Good Security) -------------------------------------------
# Set all three and passport/KTN/loyalty data is tokenized into VGS (only aliases stored here).
# Unset → self-managed AES-256-GCM at rest (VAULT_KEY). Cards always go to Stripe regardless.
# URL is vault-specific: https://{VAULT_ID}.sandbox.vault-api.verygoodvault.com (live: .live.)
# VGS_VAULT_URL=https://tntdqkzfaxo.sandbox.vault-api.verygoodvault.com
# VGS_USERNAME=...   # Vault settings → Access credentials (username)
# VGS_PASSWORD=...   # Vault settings → Access credentials (password, shown once at generation)

# --- not used until later chunks ---
# DATABASE_URL=             # Chunk 6: Prisma/Postgres (persist bookings + audit)

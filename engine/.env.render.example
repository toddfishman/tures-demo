# Tures engine — Render environment template
# Service: tures-engine  ·  https://tures-engine.onrender.com
#
# HOW TO USE
# 1. Render dashboard → tures-engine → Environment
# 2. Copy each KEY=VALUE block below (skip comment lines starting with #)
# 3. Replace every <…> placeholder with your real value
# 4. Confirm disk is attached at /data (render.yaml) → redeploy
# 5. Verify: curl -s https://tures-engine.onrender.com/health
#    Want: durable=true, auth=true, agentLoop=true, voice=true, bookingSimulated=true
#
# Generate secrets locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── P0 — Launch blockers ─────────────────────────────────────────────────────

ANTHROPIC_API_KEY=<sk-ant-api03-…>
MEM0_API_KEY=<m0-…>
DEEPGRAM_API_KEY=<your-deepgram-key>
AUTH_SECRET=<64-char-hex-generate-locally>
VAULT_KEY=<64-char-hex-generate-locally>
DATA_DIR=/data

# ── Pinned config (already in render.yaml — only add if missing) ─────────────

CORS_ORIGINS=https://toddfishman.github.io,https://tures.app,http://localhost:8123,http://localhost:8765
AGENT_MODEL=claude-opus-4-8
PUBLIC_BASE_URL=https://tures.app
PER_TRIP_FEE_USD=99
# ── Adaptive Trip Watch (pass-through + risk-scored scans) ───────────────────

TRIP_WATCH_ENABLED=true
TRIP_WATCH_TICK_MIN=60
TRIP_WATCH_ALERTS_INTERVAL_MIN=120
TRIP_WATCH_BRIEF_HOUR_UTC=7
TRIP_WATCH_DEFAULT_CAP_USD=10
TRIP_WATCH_SUBSCRIBER_CAP_USD=25
TRIP_WATCH_MARGIN_PERCENT=20

# Action Executor — Browserbase + Stagehand (optional; simulated handoff without)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
ACTION_MODEL=anthropic/claude-sonnet-4-6

# Legacy deep poller — leave 0 when Trip Watch is on
SIGNAL_WATCH_INTERVAL_MIN=0

# ── Chat brain (Fugu primary, Anthropic fallback) ────────────────────────────

SAKANA_API_KEY=<your-sakana-key>
SAKANA_API_URL=https://api.sakana.ai/v1
SAKANA_MODEL=fugu

# ── Inventory search (optional — unset = mock flights/hotels) ────────────────

DUFFEL_API_TOKEN=<duffel_test_… or duffel_live_…>
DUFFEL_API_URL=https://api.duffel.com

# ── Discover / geocoding (optional) ────────────────────────────────────────

GOOGLE_MAPS_API_KEY=<your-google-maps-platform-key>

# ── Voice TTS voice (optional — default is Orion) ────────────────────────────

DEEPGRAM_TTS_MODEL=aura-2-orion-en

# ── Telegram cross-channel (optional — all three required to enable) ─────────

TELEGRAM_BOT_TOKEN=<from-@BotFather>
TELEGRAM_WEBHOOK_SECRET=<any-random-string>
TELEGRAM_BOT_USERNAME=Tures_Travel_Bot

# ── Stripe billing — test mode OK for beta (optional) ───────────────────────

STRIPE_SECRET_KEY=<sk_test_…>
STRIPE_PUBLISHABLE_KEY=<pk_test_…>
STRIPE_PRICE_SUBSCRIPTION=<price_…>
STRIPE_PRICE_PER_TRIP=<price_…>
STRIPE_WEBHOOK_SECRET=<whsec_…>

# ── Premium signal feeds (optional — off is honest) ──────────────────────────

NEWS_API_KEY=
X_BEARER_TOKEN=
TRAFFIC_API_KEY=

# ── Model overrides (optional) ───────────────────────────────────────────────

# ASSIST_MODEL=claude-opus-4-8
# SIGNAL_MODEL=claude-opus-4-8

# ── Security hardening (optional for public beta) ────────────────────────────

# ENGINE_API_KEY=<random-hex-if-you-want-to-lock-down-api>
# RATE_LIMIT_MAX=600

# ── Real money — DO NOT ENABLE unless Todd explicitly says so ────────────────

# ALLOW_LIVE_BOOKING=false
# STRIPE_CHARGE_CARDS=false

# ── VGS production PCI vault (post-launch) ────────────────────────────────────

# VGS_VAULT_URL=https://<vault-id>.sandbox.verygoodvault.com
# VGS_USERNAME=<vgs-username>
# VGS_PASSWORD=<vgs-password>
